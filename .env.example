# CMS API (backoffice-back). Server-side only: used by the /api and /uploads rewrites.
API_URL=https://taki-cms-api.onrender.com
# Name of the session cookie set by the API (COOKIE_NAME in backoffice-back/.env)
SESSION_COOKIE=taki_bo_session
# Public website, used to display the images it ships and for "view on site" links.
NEXT_PUBLIC_SITE_URL=https://taki-ib.vercel.app/

# Local only: prefills the login form. Never set these on a deployed build (they end up in the browser bundle).
# NEXT_PUBLIC_LOGIN_EMAIL=
# NEXT_PUBLIC_LOGIN_PASSWORD=
